{
  "$schema": "https://go.kicad.org/api/schemas/v1",
  "identifier": "com.github.kbralten.kipida",
  "name": "Ki-PIDA",
  "description": "Power Integrity & Delivery Analyzer for KiCad",
  "version": "0.10.2",
  "kicad_version": "9.0.1",
  "status": "testing",
  "runtime": {
    "type": "python"
  },
  "actions": [
    {
      "identifier": "kipida_sim",
      "name": "Ki-PIDA Simulation (IPC)",
      "description": "Run Power Integrity Analysis",
      "show-button": false,
      "scopes": [
        "pcb"
      ],
      "entrypoint": "launch.py",
      "icons-light": [
        "resources/kipida.png"
      ],
      "icons-dark": [
        "resources/kipida.png"
      ]
    }
  ]
}
